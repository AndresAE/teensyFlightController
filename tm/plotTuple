import ast
import matplotlib.pyplot as plt


def first_ge_index(t, threshold):
    for i, v in enumerate(t):
        if v >= threshold:
            return i
    return None   # or raise an error if you prefer


# -----------------------------
# User settings
# -----------------------------
filename = "tm/data/telemetry_log_raw_20260328_170706.txt"   # your file

# value_index = 2  # mode
# value_index = 5  # Nz
# value_index = 3  # Nx
# value_index = 7  # q
# value_index = 20  # de
# value_index = 14  # nzC

value_index = 4  # Nz
# value_index = 19  # da
# value_index = 12  # rollRateC
# value_index = 6  # rollRate

# value_index = 21  # rollRateC
# -----------------------------

times = []
values = []

with open(filename, "r") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue

        # Safely parse the tuple string into a Python tuple
        try:
            tup = ast.literal_eval(line)
        except Exception as e:
            print("Parse error:", e, "on line:", line)
            continue

        # Extract time and desired value
        t = tup[0]
        v = tup[value_index]

        times.append(t)
        values.append(v)

# idx = first_ge_index(times, 33.73)
# idxEnd = first_ge_index(times, 37.8)

idx = first_ge_index(times, 35.77)
idxEnd = first_ge_index(times, 44.21)

# -----------------------------
# Plot
# -----------------------------
plt.figure(figsize=(10, 5))
plt.plot(times[idx:idxEnd], values[idx:idxEnd], linewidth=1.5)
plt.xlabel("Time (s)")
plt.ylabel(f"Value at index {value_index}")
plt.title(f"Telemetry Plot: index {value_index} vs time")
plt.grid(True)
plt.tight_layout()
plt.show()

# -----------------------------
# Compute delta time
# -----------------------------
dt = []
for i in range(1, len(times)):
    dt.append(times[i] - times[i-1])

# Use midpoints for plotting (optional but cleaner)
t_mid = times[1:]

# -----------------------------
# Plot
# -----------------------------
plt.figure(figsize=(10, 5))
plt.plot(t_mid, dt, linewidth=1.5)
plt.xlabel("Time (s)")
plt.ylabel("Δt (s)")
plt.title("Delta Time Between Samples")
plt.grid(True)
plt.tight_layout()
plt.show()


