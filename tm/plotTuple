import ast
import matplotlib.pyplot as plt


def first_ge_index(t, threshold):
    for i, v in enumerate(t):
        if v >= threshold:
            return i
    return None   # or raise an error if you prefer


# -----------------------------
# User settings
# -----------------------------
filename = "tm/data/telemetry_log_raw_20260309_174627.txt"   # your file
value_index = 5  # Nz
value_index = 7  # q
value_index = 30  # de
value_index = 29  # da
value_index = 27  # pitchInt
value_index = 26  # rollInt
# -----------------------------

times = []
values = []

with open(filename, "r") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue

        # Safely parse the tuple string into a Python tuple
        try:
            tup = ast.literal_eval(line)
        except Exception as e:
            print("Parse error:", e, "on line:", line)
            continue

        # Extract time and desired value
        t = tup[0]
        v = tup[value_index]

        times.append(t)
        values.append(v)

idx = 0  # first_ge_index(times, 47.5)
idxEnd = -1  # first_ge_index(times, 50.58)

# -----------------------------
# Plot
# -----------------------------
plt.figure(figsize=(10, 5))
plt.plot(times[idx:idxEnd], values[idx:idxEnd], linewidth=1.5)
plt.xlabel("Time (s)")
plt.ylabel(f"Value at index {value_index}")
plt.title(f"Telemetry Plot: index {value_index} vs time")
plt.grid(True)
plt.tight_layout()
plt.show()

